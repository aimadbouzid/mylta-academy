{
  "name": "myltaacademy",
  "version": "1.0.0",
  "description": "Plateforme e-learning premium — Algérie",
  "private": true,
  "scripts": {
    "setup": "cd backend && npm install && cd ../frontend && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm install && npm run build",
    "start": "cd backend && NODE_ENV=production node server.js",
    "start:prod": "cd backend && NODE_ENV=production node server.js",
    "db:migrate": "cd backend && npx prisma migrate dev --name init",
    "db:migrate:deploy": "cd backend && npx prisma migrate deploy",
    "db:generate": "cd backend && npx prisma generate",
    "db:seed": "cd backend && npm run db:seed",
    "db:create-admin": "cd backend && npm run db:create-admin",
    "db:studio": "cd backend && npx prisma studio",
    "db:reset": "cd backend && npm run db:reset",
    "start:pm2": "npx pm2 start ecosystem.config.js --env production",
    "pm2:logs": "npx pm2 logs mylta",
    "pm2:reload": "npx pm2 reload mylta"
  }
}
