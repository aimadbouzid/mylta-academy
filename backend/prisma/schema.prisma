// ============================================================
// SCHÉMA PRISMA — Mylta Academy Platform
// Base de données: SQLite (dev) → PostgreSQL (production)
// Pour passer en PostgreSQL:
//   1. Changer provider = "postgresql" 
//   2. Mettre à jour DATABASE_URL dans .env
//   3. npx prisma migrate dev --name pg_migration
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// UTILISATEUR
// role: "STUDENT" | "INSTRUCTOR" | "ADMIN"
// ─────────────────────────────────────────────
model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  password            String?
  googleId            String?   @unique
  facebookId          String?   @unique
  authProvider        String    @default("LOCAL") // "LOCAL" | "GOOGLE" | "FACEBOOK"
  name                String?
  role                String    @default("STUDENT")
  locale              String    @default("fr")
  emailVerified       Boolean   @default(false)
  verifyToken         String?
  verifyExpires       DateTime?
  resetToken          String?
  resetExpires        DateTime?
  sessionVersion      Int       @default(1)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Accès aux formations : réservé aux membres du club, que l'admin coche
  // lui-même. Un achat passé continue de donner accès à son cours.
  isClubMember        Boolean   @default(false)
  clubSince           DateTime?

  // Referral System Fields
  referralCode      String? @unique
  referredById      Int?
  referredBy        User?   @relation("Referrals", fields: [referredById], references: [id])
  referrals         User[]  @relation("Referrals")
  referralCount     Int     @default(0) // Count of paid referrals since last free course
  freeCoursesEarned Int     @default(0) // Number of free courses earned

  // ── Instructor / Marketplace Fields ──
  instructorBio           String?
  instructorApproved      Boolean   @default(false)
  instructorAppliedAt     DateTime?
  commissionRate          Float? // Override du taux global (null = utiliser le taux par défaut)
  instructorBalance       Float     @default(0) // Solde accumulé (revenus non retirés)
  instructorPlan          String? // Ex: Starter, Pro, Elite
  instructorPlanExpiresAt DateTime?

  // ── Vérification d'identité (obligatoire avant tout retrait) ──
  identityStatus      String    @default("NONE") // NONE | PENDING | VERIFIED | REJECTED
  identityDocPath     String? // Chemin du document d'identité fourni
  identityFullName    String? // Nom légal figurant sur le document
  identitySubmittedAt DateTime?
  identityVerifiedAt  DateTime?
  identityVerifiedBy  String? // Email de l'admin ayant validé (audit)
  identityNotes       String? // Motif de rejet / notes admin

  receipts               Receipt[]
  notifications          Notification[]
  reviews                CourseReview[]
  lessonProgress         LessonProgress[]
  coursesCreated         Course[]                @relation("InstructorCourses")
  instructorApplications InstructorApplication[]
  payouts                InstructorPayout[]
  userSessions           UserSession[]
  blogPosts              BlogPost[]
  couponsCreated         Coupon[]                @relation("CouponsCreated")
}

// ─────────────────────────────────────────────
// FORMATION
// ─────────────────────────────────────────────
model Course {
  id             Int       @id @default(autoincrement())
  title          String
  description    String
  price          Float
  discountPrice  Float?
  discountEndsAt DateTime?
  showSyllabus   Boolean   @default(true)
  thumbnail      String?
  category       String    @default("Général")
  duration       String?
  level          String    @default("Débutant")
  isPublished    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // ── Marketplace Fields ──
  instructorId    Int?
  approvedByAdmin Boolean @default(true) // Admin courses are auto-approved
  instructor      User?   @relation("InstructorCourses", fields: [instructorId], references: [id])

  lessons  Lesson[]
  receipts Receipt[]
  reviews  CourseReview[]
  coupons  Coupon[]
}

// ─────────────────────────────────────────────
// LEÇON
// externalVideoUrl: jamais exposé au client via l'API publique
// ─────────────────────────────────────────────
model Lesson {
  id               Int      @id @default(autoincrement())
  title            String
  description      String?
  externalVideoUrl String
  order            Int      @default(0)
  duration         String?
  courseId         Int
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lessonProgress LessonProgress[]
  resources      CourseResource[]
}

// ─────────────────────────────────────────────
// REÇU DE PAIEMENT
// status: "PENDING" | "APPROVED" | "REJECTED"
// paymentType: "CCP" | "BARIDIMOB" | "EDAHABIA" | "CIB" | "CHARGILY" | "STRIPE" | "PAYPAL" | "REFERRAL_REWARD"
// ─────────────────────────────────────────────
model Receipt {
  id                 Int      @id @default(autoincrement())
  userId             Int
  courseId           Int
  amount             Float
  status             String   @default("PENDING")
  paymentType        String   @default("CCP")
  receiptImage       String?
  transactionId      String?
  chargilyCheckoutId String?  @unique
  stripeCheckoutId   String?  @unique
  paypalOrderId      String?  @unique
  idempotencyKey     String?  @unique
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // ── Marketplace Commission Tracking ──
  instructorEarnings Float? // Montant que le formateur gagne
  platformCommission Float? // Montant que la plateforme gagne

  // ── Refund System Fields ──
  approvedAt    DateTime?
  refundStatus  String    @default("NONE") // NONE, REQUESTED, REJECTED_BY_USER
  refundAccount String? // Ex: Numéro BaridiMob

  couponId Int?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
}

// ─────────────────────────────────────────────
// NOTIFICATIONS ETUDIANT
// type: "SUCCESS" | "WARNING" | "INFO"
// ─────────────────────────────────────────────
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// EVALUATION (ÉTOILES)
// ─────────────────────────────────────────────
model CourseReview {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// ─────────────────────────────────────────────
// PROGRESSION DES LEÇONS
// ─────────────────────────────────────────────
model LessonProgress {
  id          Int      @id @default(autoincrement())
  userId      Int
  lessonId    Int
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

// ─────────────────────────────────────────────
// CANDIDATURE FORMATEUR (Marketplace)
// status: "PENDING" | "APPROVED" | "REJECTED"
// ─────────────────────────────────────────────
model InstructorApplication {
  id           Int      @id @default(autoincrement())
  userId       Int
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  message      String? // Message/motivation du formateur
  specialty    String? // Spécialité du formateur
  adminNotes   String? // Notes de l'admin
  receiptId    Int? // Lien vers le paiement de la place (optionnel)
  receiptImage String? // Chemin de l'image du reçu de paiement
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// RETRAIT FORMATEUR (Marketplace)
// status: "PENDING" | "COMPLETED" | "REJECTED"
// ─────────────────────────────────────────────
model InstructorPayout {
  id           Int     @id @default(autoincrement())
  reference    String  @unique // Réf. de demande communicable (ex: RET-2026-000123)
  instructorId Int
  amount       Float // Montant du retrait
  method       String  @default("CCP") // CCP | BARIDIMOB | EDAHABIA
  accountInfo  String? // Info compte (numéro CCP, etc.)
  status       String  @default("PENDING") // PENDING | COMPLETED | REJECTED
  notes        String?

  // ── Traçabilité / audit du traitement ──
  identityFullName String? // Nom légal vérifié au moment de la demande (figé)
  processedAt      DateTime?
  processedBy      String? // Email de l'admin ayant traité la demande

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instructor User @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId, status])
}

// ─────────────────────────────────────────────
// ABONNÉS NEWSLETTER
// ─────────────────────────────────────────────
model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  source    String   @default("resources_page")
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// LOGS DE CLIC ET VISITES (Analytics & Présence)
// ─────────────────────────────────────────────
model ClickLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  userName    String?
  userEmail   String?
  isGuest     Boolean  @default(true)
  pageUrl     String
  elementText String?
  elementTag  String?
  elementId   String?
  ip          String?
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────
// SESSIONS UTILISATEUR (Limitation d'appareils)
// ─────────────────────────────────────────────
model UserSession {
  id        String   @id @default(uuid())
  userId    Int
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// LOGS DE SÉCURITÉ (Audit & Tentatives de fraude)
// ─────────────────────────────────────────────
model SecurityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  details   String?
  ip        String?
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// COUPONS DE REDUCTION
// ─────────────────────────────────────────────
model Coupon {
  id              Int       @id @default(autoincrement())
  code            String    @unique
  discountPercent Int
  maxUses         Int       @default(100)
  currentUses     Int       @default(0)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  // ── Portée du coupon ──
  // courseId null = coupon global (admin). Sinon, valable uniquement sur cette formation.
  courseId    Int?
  course      Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // Formateur propriétaire du coupon (null = créé par l'admin)
  createdById Int?
  createdBy   User?   @relation("CouponsCreated", fields: [createdById], references: [id])

  receipts Receipt[]

  @@index([courseId])
  @@index([createdById])
}

// ─────────────────────────────────────────────
// RESSOURCES TELECHARGEABLES (COURS)
// ─────────────────────────────────────────────
model CourseResource {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  title     String
  url       String
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// BLOG & SEO
// ─────────────────────────────────────────────
model BlogPost {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  summary     String?
  content     String
  thumbnail   String?
  isPublished Boolean  @default(false)
  authorId    Int
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────
// COACHING EN LIGNE — réservations publiques (sans compte)
// date : "YYYY-MM-DD" (chaîne, pas de décalage de fuseau horaire)
// status: "PENDING" | "CONFIRMED" | "CANCELLED"
// ─────────────────────────────────────────────
model CoachingBooking {
  id           Int      @id @default(autoincrement())
  fullName     String
  phone        String
  topicId      String
  topicLabel   String
  formatLabel  String   @default("")
  participants Int      @default(1)
  companions   Json?
  channel      String   @default("")
  level        String   @default("")
  price        Int      @default(0)
  date         String
  timeSlot     String   @default("")
  message      String?
  status       String   @default("PENDING")
  ip           String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([date])
}

// ─────────────────────────────────────────────
// COACHING PRÉSENTIEL — sessions de groupe et inscriptions
// date : "YYYY-MM-DD" ; capacity : places maximum du groupe
// Inscription sans sessionId = liste d'attente (date pas encore fixée)
// ─────────────────────────────────────────────
model InPersonSession {
  id            Int                    @id @default(autoincrement())
  title         String                 @default("")
  date          String
  startTime     String                 @default("")
  endTime       String                 @default("")
  city          String                 @default("")
  place         String                 @default("")
  capacity      Int                    @default(10)
  price         Int                    @default(0)
  isOpen        Boolean                @default(true)
  registrations InPersonRegistration[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([date])
}

model InPersonRegistration {
  id        Int              @id @default(autoincrement())
  sessionId Int?
  session   InPersonSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  fullName  String
  phone     String
  city      String           @default("")
  profile   String           @default("")
  message   String?
  status    String           @default("PENDING")
  isStudent   Boolean        @default(false)
  studentCard String?
  formation   String         @default("") // "" = formation 3 jours ; "express" = formation d'un jour (samedi)
  day         String         @default("") // jour choisi (AAAA-MM-JJ) pour la formation d'un jour
  ip        String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([sessionId])
  @@index([formation, day])
}

model ContestEntry {
  id        Int      @id @default(autoincrement())
  fullName  String
  phone     String   @unique
  city      String   @default("")
  prize     String   @default("")
  ip        String?
  createdAt DateTime @default(now())
}

// Avis laissés par les visiteurs sur l'accueil : publiés tout de suite, masquables dans l'admin.
model SiteReview {
  id        Int      @id @default(autoincrement())
  fullName  String
  role      String   @default("")
  text      String
  status    String   @default("PUBLISHED") // PUBLISHED | HIDDEN
  ip        String?
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

// Inscriptions aux formations gratuites données au club scientifique de
// l'université de Béjaïa (Targa Ouzemmour). Table à part : les organisateurs
// y accèdent avec leur propre mot de passe, sans rien voir du reste du site.
model ClubRegistration {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  phone     String
  training  String // slug : voir backend/utils/clubTrainings.js
  // Club étudiant d'appartenance, choisi à l'inscription. On garde le nom et
  // non l'identifiant : la liste reste lisible même si le club est retiré.
  club      String @default("")
  // Jeton du QR code remis à l'inscription : c'est lui que l'organisateur
  // scanne à l'entrée. Court, imprononçable, sans rapport avec l'identité.
  token       String    @unique
  checkedInAt DateTime? // pointage à l'entrée ; null tant que la personne n'est pas venue
  ip        String?
  createdAt DateTime @default(now())

  // Un même numéro ne s'inscrit qu'une fois par formation, mais peut
  // s'inscrire aux trois.
  @@unique([phone, training])
  @@index([training, createdAt])
}

// Clubs étudiants proposés au moment de l'inscription. Les organisateurs les
// créent eux-mêmes depuis leur espace, logo compris.
// Les séances du club : les trois formations gratuites au départ, puis tout
// ce que les organisateurs ajoutent. Elles étaient écrites dans le code, donc
// intouchables sans déploiement ; elles vivent maintenant en base.
model ClubTraining {
  id        Int      @id @default(autoincrement())
  slug      String   @unique // repris dans ClubRegistration.training
  title     String
  text      String   @default("")
  date      String   @default("") // vide = « date bientôt annoncée »
  active    Boolean  @default(true)
  position  Int      @default(0) // ordre d'affichage
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
}

// Organisateur du club : un compte nominatif pour l'espace /club/admin.
// Il ne donne accès qu'au club — ni aux élèves de l'académie, ni aux
// paiements, ni aux réglages du site. Séparé du modèle User pour cette
// raison : un organisateur n'est pas un compte de l'académie.
model ClubOrganizer {
  id        Int      @id @default(autoincrement())
  name      String
  login     String   @unique // identifiant court, en minuscules
  password  String // haché avec argon2, jamais en clair
  active    Boolean  @default(true)
  lastSeenAt DateTime?
  createdAt DateTime @default(now())
}

// Événement du club : open day, atelier, rencontre. Publié par les
// organisateurs depuis /club/admin, visible sur la page publique du club.
model ClubEvent {
  id        Int     @id @default(autoincrement())
  slug      String  @unique // identifiant lisible dans l'URL
  title     String
  summary   String  @default("") // une ou deux phrases sous le titre
  date      String // AAAA-MM-JJ, comme les sessions présentiel
  startTime String  @default("")
  endTime   String  @default("")
  place     String  @default("")
  // Nature de la rencontre : open-day, seminaire, conference, atelier, autre.
  kind      String  @default("open-day")
  poster    String  @default("") // /uploads/clubs/<fichier>
  // 0 = pas de limite de places. Au-delà, l'inscription se ferme d'elle-même.
  capacity  Int     @default(0)
  // Tant qu'il n'est pas publié, l'événement ne se voit que des organisateurs.
  published Boolean @default(false)
  // Déroulé de la journée : [{ time: "09:00", label: "Accueil" }, …]
  programme Json    @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations ClubEventRegistration[]

  @@index([date])
}

model ClubEventRegistration {
  id        Int       @id @default(autoincrement())
  eventId   Int
  event     ClubEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  phone     String
  club      String    @default("")
  // Même billet que les trois formations : un jeton court, scanné à l'entrée.
  token       String    @unique
  checkedInAt DateTime?
  ip          String?
  createdAt   DateTime  @default(now())

  // Un numéro ne s'inscrit qu'une fois par événement.
  @@unique([phone, eventId])
  @@index([eventId, createdAt])
}

model ClubGroup {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  logo      String   @default("") // /uploads/clubs/<fichier>.webp
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// MYLTA LIVE — Conférences interactives
// Session: titre, description, statut (draft|live|ended)
// Participant: email, nom affiché, score
// Question: texte, type (poll|quiz|freeform), options, réponse correcte
// Answer: réponse du participant
// Vote: vote du participant
// ─────────────────────────────────────────────
model LiveSession {
  id              String   @id @default(cuid())
  title           String
  description     String?
  status          String   @default("draft") // draft | live | ended
  maxParticipants Int?
  createdBy       String   // userId (Int)
  createdAt       DateTime @default(now())
  startedAt       DateTime?
  endedAt         DateTime?

  questions    LiveQuestion[]
  votes        LiveVote[]
  participants LiveParticipant[]

  @@index([createdBy, status])
}

model LiveParticipant {
  id          String   @id @default(cuid())
  sessionId   String
  session     LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  email       String
  displayName String
  joinedAt    DateTime @default(now())
  score       Int      @default(0)

  answers LiveAnswer[]
  votes   LiveVote[]

  @@unique([sessionId, email])
  @@index([sessionId])
}

model LiveQuestion {
  id            String   @id @default(cuid())
  sessionId     String
  session       LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  text          String
  type          String   @default("poll") // poll | quiz | freeform
  options       String[] // JSON: ["A", "B", "C"]
  correctAnswer String?
  createdAt     DateTime @default(now())

  answers LiveAnswer[]
  votes   LiveVote[]

  @@index([sessionId, createdAt])
}

model LiveAnswer {
  id            String   @id @default(cuid())
  questionId    String
  question      LiveQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  participantId String
  participant   LiveParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  answer        String
  isCorrect     Boolean?
  answeredAt    DateTime @default(now())

  @@unique([questionId, participantId])
  @@index([questionId, answeredAt])
}

model LiveVote {
  id            String   @id @default(cuid())
  questionId    String
  question      LiveQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sessionId     String
  session       LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participantId String
  participant   LiveParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  option        String   // "A", "B", "C", etc.
  votedAt       DateTime @default(now())

  @@unique([questionId, participantId])
  @@index([sessionId, votedAt])
}
