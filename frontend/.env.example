# Variables d'environnement — Mylta Academy Frontend
# Copier ce fichier en `.env` puis remplir les valeurs.
# IMPORTANT: Ne jamais committer le fichier `.env` réel dans Git.

# URL de base de l'API backend (ex: http://localhost:3001/api en dev)
VITE_API_URL=

# Google OAuth — Client ID (public, correspond à GOOGLE_CLIENT_ID côté backend)
VITE_GOOGLE_CLIENT_ID=

# Facebook Login — App ID (public, jamais l'App Secret côté frontend)
# Créer une app sur https://developers.facebook.com/apps → produit "Facebook Login"
VITE_FACEBOOK_APP_ID=
