# Variables d'environnement — Mylta Academy Backend
# Copier ce fichier en `.env` puis remplir les valeurs.
# IMPORTANT: Ne jamais committer le fichier `.env` réel dans Git.

# ─── Base de données ───────────────────────────────────────────
# DEV: PostgreSQL local (créée via `createdb myacademy`)
DATABASE_URL="postgresql://user@localhost:5432/myacademy?schema=public"

# ─── JWT — CHANGER ABSOLUMENT EN PRODUCTION ───────────────────
JWT_SECRET="changez_moi_en_production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── Serveur ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS — Origines autorisées (séparées par virgule) ────────
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# ─── Upload ───────────────────────────────────────────────────
UPLOAD_DIR="./uploads/receipts"

# ─── Edahabia Webhook ─────────────────────────────────────────
EDAHABIA_WEBHOOK_SECRET="edahabia_secret_changez_moi"

# ─── Chargily Pay ─────────────────────────────────────────────
# Obtenir depuis https://pay.chargily.com → Paramètres → Clé API
# Mode test: https://pay.chargily.net/test/api/v2
# Mode production: https://pay.chargily.net/api/v2
CHARGILY_SECRET_KEY=
CHARGILY_API_URL="https://pay.chargily.net/api/v2"

# ─── Stripe (carte internationale) — COMING SOON ──────────────
# EN ATTENTE: compte Stripe pas encore ouvert. Laisser vide tant que
# le compte n'est pas créé : le backend répond alors 503 et le
# front affiche "Bientôt disponible" au lieu du bouton de paiement.
# Une fois le compte ouvert, récupérer les clés ici :
#   https://dashboard.stripe.com/apikeys (clé secrète, sk_live_… / sk_test_…)
#   https://dashboard.stripe.com/webhooks (secret du endpoint, whsec_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_URL="https://api.stripe.com/v1"

# ─── PayPal (international) — COMING SOON ─────────────────────
# EN ATTENTE: compte business PayPal pas encore ouvert. Laisser vide
# tant que le compte n'est pas créé (même comportement 503 que Stripe).
# Une fois le compte ouvert, récupérer les identifiants ici :
#   https://developer.paypal.com/dashboard/applications (Client ID / Secret)
#   Webhooks de l'app → Webhook ID
# Sandbox: https://api-m.sandbox.paypal.com — Production: https://api-m.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_URL="https://api-m.sandbox.paypal.com"

# ─── Site URL (pour SEO) ──────────────────────────────────────
SITE_URL="https://myltaacademy.dz"

# ─── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ─── Facebook Login ────────────────────────────────────────────
# Créer une app sur https://developers.facebook.com/apps → produit
# "Facebook Login" → Paramètres : App ID et App Secret.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── SMTP — Envoi des emails (activation, reset mot de passe) ──
# Sans SMTP_USER et SMTP_PASS, aucun email n'est envoyé :
#   - hors production, les comptes sont activés automatiquement à l'inscription
#   - en production, les comptes resteraient bloqués → ces valeurs sont OBLIGATOIRES
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ─── Notification WhatsApp des réservations (CallMeBot) ─────────
# Facultatif. Activer sur https://www.callmebot.com (rubrique WhatsApp),
# puis renseigner votre numéro (format international) et la clé reçue.
# Ne jamais mettre ces valeurs dans les réglages admin (ils sont publics).
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# Espace organisateurs du club scientifique (/club/admin).
# Mot de passe partagé, à choisir vous-même et à transmettre aux organisateurs.
# Tant qu'il est vide, l'espace répond « pas encore configuré ».
CLUB_ADMIN_PASSWORD=
